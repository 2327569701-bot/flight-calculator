{
  "name": "flight-calculator",
  "version": "2.0.1",
  "description": "傻瓜式飞行计算器 - 支持下滑角、TOD、垂直速度、燃油计算等",
  "main": "main.js",
  "scripts": {
    "build:web": "node scripts/build-web.cjs",
    "test:diagrams": "node --test scripts/test-diagrams.cjs",
    "start": "node scripts/launch-desktop.cjs",
    "dev": "electron . --dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "pack": "electron-builder --dir",
    "build": "electron-builder"
  },
  "author": "残月",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
